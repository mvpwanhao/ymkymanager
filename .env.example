# 复制为 .env 后修改。在 ymky_manager 目录下启动时自动加载。

# 会话 Cookie 签名密钥（生产环境务必改为随机长字符串）
YMKY_SECRET_KEY=请改为至少16位随机字符串

# 运行环境：development（默认）或 production。production 下若仍为默认密钥会在日志中告警。
# YMKY_ENV=development

# 反代/对公网部署时建议设置 Host 白名单（英文逗号分隔，不含端口）。例：
# app.example.com,www.app.example.com,127.0.0.1,localhost
# 留空表示不校验 Host（仅本机或内网调试时可留空）。
# 若已填写白名单、又用「局域网 IP:端口」在手机上访问，必须把该 IP 一并列入（如 192.168.1.10），
# 否则顶栏网络状态会红灯（/health 返回 400 Invalid host）。
# YMKY_TRUSTED_HOSTS=

# 健康检查 JSON 中可选返回 version 字段，便于负载均衡/脚本探测。
# YMKY_APP_VERSION=1.0.0

# 可选：PostgreSQL，与旧版 Streamlit 项目相同表名 actual_production / energy_reporting
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname?sslmode=require

# Server酱 微信提醒（可选）
# SERVERCHAN_SENDKEY=

# 本地调试时在登录页预填密码（勿在生产开启）
# YMKY_LOCAL_DEBUG=0

# 密码也可通过环境变量设置（优先级低于 data/runtime/app_passwords.json 中的覆盖项）
# YMKY_PASSWORD_ADMIN=
# YMKY_PASSWORD_REPORTER=
# YMKY_PASSWORD_VIEWER=
