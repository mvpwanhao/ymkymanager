# =============================================================================
# 复制本文件为 .env 后在项目根目录启动（加载顺序见 app/config.py）
# =============================================================================

# ── 必选 ────────────────────────────────────────────────────────────────────
# 会话 Cookie 签名密钥，至少 16 个字符；生产环境请用强随机串（勿提交到 Git）
YMKY_SECRET_KEY=请改为至少16位随机字符串

# ── 运行环境 ─────────────────────────────────────────────────────────────────
# development（默认）| production —— production 下若密钥过于简单会在日志中告警
YMKY_ENV=development

# ── Host 白名单（逗号分隔，不含端口）────────────────────────────────────────
# 留空则不校验 Host，仅建议在可信内网/本机调试时留空。
# 反向代理或用域名访问时填入真实 Host；手机上用局域网 IP 访问必须把该 IP 写入，例如：
# YMKY_TRUSTED_HOSTS=127.0.0.1,localhost,app.example.com,192.168.14.222
YMKY_TRUSTED_HOSTS=

# ── 可选：版本与健康检查 ───────────────────────────────────────────────────
# 留空则 /health.version 默认为仓库 VERSION 文件加 v；仅覆盖临时标识时填写
YMKY_APP_VERSION=

# ── 可选：会话时长（秒）──────────────────────────────────────────────────────
# 默认 28800（8 小时）
# YMKY_SESSION_TTL=28800

# ── 可选：PostgreSQL（不设则默认用 Excel 文件 data/*.xlsx）──────────────────
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbname

# ── 可选：Server酱微信提醒 ───────────────────────────────────────────────────
# SERVERCHAN_SENDKEY=

# ── 仅开发：登录页是否预填密码（生产务必关闭）────────────────────────────────
YMKY_LOCAL_DEBUG=0

# ── 可选：三类角色初始/覆盖密码（与 .streamlit/secrets.toml、[passwords] 相比优先级见代码）────────────────
# 留空则用内置默认值；可在后台「密码管理」里改并被 data/runtime/app_passwords.json 覆盖
# （兼容别名 YMKY_ADMIN / YMKY_REPORTER / YMKY_VIEWER）
# YMKY_PASSWORD_ADMIN=
# YMKY_PASSWORD_REPORTER=
# YMKY_PASSWORD_VIEWER=

# ── SakuraFrp Docker 启动器（docker-compose.yml profile: natfrp）────────────────
# 必填：面板「用户信息」页的访问密钥
# NATFRP_TOKEN=
# 可选：常驻启用穿透则取消下行注释（使 docker compose up -d 即包含 sakurafrp）
# COMPOSE_PROFILES=natfrp
# 可选远程管理密码（≥8）：勿提交仓库；推荐在本机 docker-compose.override.yml 中追加 environment NATFRP_REMOTE

